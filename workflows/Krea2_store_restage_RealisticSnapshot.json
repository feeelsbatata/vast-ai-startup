   "outputs": [],
   "title": "Resolution",
   "properties": {
    "Node name for S&R": "Note"
   },
   "widgets_values": [
    "Output resolution. 1 MP (1:1 or 3:4 for\nproduct shots) is the sweet spot; go\nhigher only for single-person edits."
   ],
   "color": "#432",
   "bgcolor": "#653"
  },
